<!-- if click edit btn, action set in js. If popup persist, action is set here (on error, modalFileId is saved) -->
<% const formAction = locals.modalFileId ? `/drive/file/${locals.modalFileId}/edit` : "" %>
<form action="<%= formAction %>" method="post" id="edit-file-form">
  <h2>Edit file</h2>
  <%- include("../errors") %>
  <div class="column gap-s">
    <label for="fileName" class="column">
      <!-- value set in js -->
      File name:
      <input
        type="text"
        name="fileName"
        id="fileName"
        placeholder="Name your file..."
        value="<%= locals.modalValues?.fileName || '' %>"
        required
    /></label>
    <!-- for redirection to same page -->
    <input
      type="text"
      name="currentFolderId"
      value="<%= locals.folderId || '' %>"
      hidden
    />
    <button type="submit" class="button-style-2">Edit</button>
  </div>
</form>
