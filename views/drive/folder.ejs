<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <script src="/js/eventListeners.js" defer></script>
    <title>folder - <%= locals.pageTitle %> | <%= locals.appTitle %></title>
  </head>
  <body>
    <%- include("../partials/spinner") %>
    <%- include("../partials/header") %>

    <main>
      <!-- share link-->
      <% if (locals.shareLink && !locals.thisShareToken) { %>

      <div class="row gap" id="share-link">
        <b>Share Link:</b
        ><a
          href="<%= locals.shareLink %>"
          target="_blank"
          rel="noopener noreferrer"
          ><%= locals.shareLink %></a
        >
      </div>
      <% } %>

      <!-- current folder -->
      <div class="row gap-s align-center top-spacing-l">
        <h2 class="cut-width"><%= locals.pageTitle %></h2>
        <!-- tools -->
        <% if (!locals.thisShareToken) { %>
        <span>—</span>
        <div class="row gap-s align-center">
          <!-- no edit root -->
          <% if (locals.folderId !== "root") { %>
          <!-- edit -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-square-pen-icon lucide-square-pen edit-folder-button show-clickable hover-white"
            data-folder-id="<%= locals.folderId %>"
            data-folder-name="<%= locals.pageTitle %>"
          >
            <path
              d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
            />
            <path
              d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"
            />
          </svg>
          <% } %>

          <!-- delete -->
          <form
            action="/drive/folder/<%= locals.folderId %>/delete"
            method="post"
            class="column"
          >
            <input
              type="text"
              name="currentFolderId"
              value="<%= locals.folderId %>"
              hidden
            />
            <% const message = locals.folderId !== "root"
    ? `Are you sure you want to delete "${locals.pageTitle}" and all its contents?`
    : "Are you sure you clear your entire drive of all its contents?"
  %>
            <button
              type="submit"
              onclick="return confirm('<%= message %>');"
              class="no-button-style"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-trash2-icon lucide-trash-2 hover-white"
              >
                <path d="M10 11v6" />
                <path d="M14 11v6" />
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                <path d="M3 6h18" />
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
              </svg>
            </button>
          </form>

          <!-- share -->
          <% if (locals.folderId !== "root") { %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-share-icon lucide-share share-folder-button hover-white show-clickable"
          >
            <path d="M12 2v13" />
            <path d="m16 6-4-4-4 4" />
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
          </svg>
          <% } %>
        </div>
        <% } %>
      </div>

      <!-- current path -->
      <div class="row gap-xs" id="current-path">
        <span><b>location:</b></span>
        <span class="row wrap">
          <% if (!locals.thisShareToken) { %>
          <a href="/drive/folder/root" class="underline-hover">root</a>
          <% } else { %>
          <span>...</span>
          <% } %>

          <% locals.parentFolders.forEach((parentFolder) => { %> /
          <a
            href="<%= parentFolder.id %>"
            class="underline-hover cut-width-small"
          >
            <%= parentFolder.name %>
          </a>
          <% }) %>
        </span>
      </div>

      <div class="main-sections">
        <!-- ========================================================= -->
        <!-- folders -->
        <!-- ========================================================= -->
        <div class="main-drive-section column gap align-center">
          <div class="child-lines">
            <% if (locals.childFolders) { %> <%
            locals.childFolders.forEach((childFolder) => { %>
            <div
              class="child-line row gap-s align-center just-space-between padding-top-s padding-bottom-s padding-left padding-right show-spinner"
              onclick="window.location.href = '<%= childFolder.id %>'"
            >
              <a class="row gap-s" href="<%= childFolder.id %>">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-folder-icon lucide-folder primary-color"
                >
                  <path
                    d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
                  />
                </svg>
                <span class="cut-width"><%= childFolder.name %></span>
              </a>

              <!-- tools -->
              <% if (!locals.thisShareToken) { %>

              <div
                class="width-max-content row gap-s align-center"
                onclick="event.stopPropagation()"
              >
                <!-- edit folder -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-square-pen-icon lucide-square-pen edit-folder-button show-clickable hover-white primary-color"
                  data-folder-id="<%= childFolder.id %>"
                  data-folder-name="<%= childFolder.name %>"
                >
                  <path
                    d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                  />
                  <path
                    d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"
                  />
                </svg>

                <!-- delete folder -->
                <form
                  action="/drive/folder/<%= childFolder.id %>/delete"
                  method="post"
                  class="column"
                >
                  <input
                    type="text"
                    name="currentFolderId"
                    value="<%= locals.folderId %>"
                    hidden
                  />
                  <button
                    type="submit"
                    onclick="
                      return confirm(
                        'Are you sure you want to delete &quot;<%= childFolder.name %>&quot; and all its contents?',
                      );
                    "
                    class="no-button-style"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="lucide lucide-trash2-icon lucide-trash-2 hover-white"
                    >
                      <path d="M10 11v6" />
                      <path d="M14 11v6" />
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                      <path d="M3 6h18" />
                      <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    </svg>
                  </button>
                </form>
              </div>
              <% } %>
            </div>

            <% }) %>
            <% } %>
          </div>

          <% if (!locals.thisShareToken) { %>

          <button id="create-folder-button" class="button-style-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-folder-plus-icon lucide-folder-plus show-clickable hover-white"
            >
              <path d="M12 10v6" />
              <path d="M9 13h6" />
              <path
                d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
              />
            </svg>
          </button>
          <% } %>
        </div>

        <!-- ========================================================= -->
        <!-- files -->
        <!-- ========================================================= -->
        <div class="main-drive-section column gap align-center">
          <div class="child-lines">
            <% if (locals.files) { %> <% files.forEach((file)=> { %>

            <% let href = !locals.thisShareToken ? `/drive/file/${file.id}` : `/share/${locals.thisShareToken}/file/${file.id}` %>
            <div
              class="child-line row gap-s align-center just-space-between padding-top-s padding-bottom-s padding-left padding-right show-spinner"
              onclick="window.location.href = '<%= href %>'"
            >
              <a href="<%= href %>" class="row gap-s">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-file-icon lucide-file primary-color"
                >
                  <path
                    d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"
                  />
                  <path d="M14 2v5a1 1 0 0 0 1 1h5" />
                </svg>
                <span class="cut-width"> <%= file.filename %> </span>
              </a>
              <!-- tools -->
              <div
                class="width-max-content row gap-s align-center"
                onclick="event.stopPropagation()"
              >
                <!-- edit file -->
                <% if (!locals.thisShareToken) { %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-square-pen-icon lucide-square-pen edit-file-button show-clickable hover-white"
                  data-file-id="<%= file.id %>"
                  data-file-name="<%= file.filename %>"
                >
                  <path
                    d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                  />
                  <path
                    d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"
                  />
                </svg>
                <% } %>

                <% href = !locals.thisShareToken ? `/drive/file/${file.id}/download` : `/share/${locals.thisShareToken}/file/${file.id}/download` %>
                <a href="<%= href %>" download="<%= file.name %>">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-download-icon lucide-download primary-color"
                  >
                    <path d="M12 15V3" />
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <path d="m7 10 5 5 5-5" />
                  </svg>
                </a>

                <!-- delete file -->
                <% if (!locals.thisShareToken) { %>
                <form
                  action="/drive/file/<%= file.id %>/delete"
                  method="post"
                  class="column"
                >
                  <input
                    type="text"
                    name="currentFolderId"
                    value="<%= locals.folderId %>"
                    hidden
                  />
                  <button
                    type="submit"
                    onclick="
                      return confirm(
                        'Are you sure you want to delete file: &quot;<%= file.filename %>&quot;?',
                      );
                    "
                    class="no-button-style"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="lucide lucide-trash2-icon lucide-trash-2 hover-white"
                    >
                      <path d="M10 11v6" />
                      <path d="M14 11v6" />
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                      <path d="M3 6h18" />
                      <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    </svg>
                  </button>
                </form>
                <% } %>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>

          <% if (!locals.thisShareToken) { %>
          <button id="add-files-button" class="button-style-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-file-plus-icon lucide-file-plus show-clickable hover-white"
            >
              <path
                d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"
              />
              <path d="M14 2v5a1 1 0 0 0 1 1h5" />
              <path d="M9 15h6" />
              <path d="M12 18v-6" />
            </svg>
          </button>
          <% } %>
        </div>
      </div>

      <%- include("../partials/modals/create-folder") %>
      <%- include("../partials/modals/edit-folder") %>
      <%- include("../partials/modals/add-files") %>
      <%- include("../partials/modals/edit-file") %>
      <%- include("../partials/modals/share-folder") %>
    </main>
  </body>
</html>

<script>
  // modal control
  document.addEventListener("DOMContentLoaded", () => {
    if ("<%= locals.modal %>" === "createFolder") {
      const createFolderModal = document.getElementById("create-folder-modal");
      createFolderModal.classList.toggle("hidden");

      createFolderModal.querySelector("input#folderName").focus();
    }
    if ("<%= locals.modal %>" === "editFolder") {
      const editFolderModal = document.getElementById("edit-folder-modal");
      editFolderModal.classList.toggle("hidden");

      const editFolderInput = editFolderModal.querySelector("input#folderName");

      editFolderInput.focus();
      editFolderInput.select();
    }
    if ("<%= locals.modal %>" === "addFiles") {
      const addFilesModal = document.getElementById("add-files-modal");
      addFilesModal.classList.toggle("hidden");
    }
    if ("<%= locals.modal %>" === "editFile") {
      const editFileModal = document.getElementById("edit-file-modal");
      editFileModal.classList.toggle("hidden");

      const editFileInput = editFileModal.querySelector("input#fileName");

      editFileInput.focus();
      editFileInput.select();
    }
  });
</script>
